{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://business-automation-system.local/schemas/wf-05-figma-handoff.json",
  "title": "WF-05 Figma-to-Development Handoff Event (Proposal)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action",
    "request_id",
    "plan_id",
    "handoff_id",
    "design_reference",
    "task_mappings"
  ],
  "properties": {
    "action": {"const": "CREATE_HANDOFF"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 100},
    "plan_id": {"type": "string", "minLength": 1, "maxLength": 100},
    "handoff_id": {"type": "string", "minLength": 1, "maxLength": 100},
    "design_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_url", "node_ids"],
      "properties": {
        "file_url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "^https://(www\\.)?figma\\.com/"
        },
        "node_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 200}
        },
        "revision_id": {"type": "string", "minLength": 1, "maxLength": 200}
      }
    },
    "task_mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "design_node_ids", "acceptance_criteria"],
        "properties": {
          "task_id": {"type": "string", "minLength": 1, "maxLength": 100},
          "design_node_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 200}
          },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["criterion_id", "description"],
              "properties": {
                "criterion_id": {"type": "string", "minLength": 1, "maxLength": 100},
                "description": {"type": "string", "minLength": 1, "maxLength": 2000}
              }
            }
          }
        }
      }
    }
  }
}
