{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://business-automation-system.local/schemas/wf-03-orchestration.json",
  "title": "WF-03 Orchestration Input",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "plan_id", "source", "review_signal", "tasks"],
  "properties": {
    "request_id": {"type": "string", "minLength": 1, "maxLength": 100},
    "plan_id": {"type": "string", "minLength": 1, "maxLength": 100},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow", "request_id", "planning_state"],
      "properties": {
        "workflow": {"const": "WF-02"},
        "request_id": {"type": "string", "minLength": 1, "maxLength": 100},
        "planning_state": {"const": "PLANNED"}
      }
    },
    "review_signal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["human_review_required", "approval_status", "reason_codes", "review_requirement_ids"],
      "properties": {
        "human_review_required": {"type": "boolean"},
        "approval_status": {"type": "string", "enum": ["not_required", "pending_human_review"]},
        "reason_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "enum": ["HIGH_IMPACT_REVIEW_REQUIRED"]}
        },
        "review_requirement_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 100}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"human_review_required": {"const": true}},
            "required": ["human_review_required"]
          },
          "then": {
            "properties": {
              "approval_status": {"const": "pending_human_review"},
              "reason_codes": {
                "minItems": 1,
                "contains": {"const": "HIGH_IMPACT_REVIEW_REQUIRED"}
              },
              "review_requirement_ids": {"minItems": 1}
            }
          }
        },
        {
          "if": {
            "properties": {"human_review_required": {"const": false}},
            "required": ["human_review_required"]
          },
          "then": {
            "properties": {
              "approval_status": {"const": "not_required"},
              "reason_codes": {"maxItems": 0},
              "review_requirement_ids": {"maxItems": 0}
            }
          }
        }
      ]
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "title", "requirement_ids"],
        "properties": {
          "task_id": {"type": "string", "minLength": 1, "maxLength": 100},
          "title": {"type": "string", "minLength": 1, "maxLength": 300},
          "requirement_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1, "maxLength": 100}
          },
          "depends_on": {
            "type": "array",
            "items": {"type": "string", "minLength": 1, "maxLength": 100},
            "uniqueItems": true
          },
          "risk": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
          "environment": {"type": "string", "enum": ["dev", "staging", "prod"]},
          "action": {"type": "string", "minLength": 1, "maxLength": 100}
        }
      }
    }
  }
}
