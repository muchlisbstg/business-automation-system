{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://business-automation-system.local/schemas/wf-07-api-qa.json",
  "title": "WF-07 API QA Request (Proposal)",
  "type": "object",
  "additionalProperties": false,
  "required": ["action", "request_id", "plan_id", "qa_run_id", "target", "checks"],
  "properties": {
    "action": {"const": "REQUEST_API_QA"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 100},
    "plan_id": {"type": "string", "minLength": 1, "maxLength": 100},
    "qa_run_id": {"type": "string", "minLength": 1, "maxLength": 100},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit_sha", "base_url", "environment"],
      "properties": {
        "commit_sha": {
          "type": "string",
          "pattern": "^(?:[a-fA-F0-9]{40}|[a-fA-F0-9]{64})$"
        },
        "base_url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^https://[^/@\\s?#]+(?:/[^\\s?#]*)?$"
        },
        "environment": {
          "type": "string",
          "enum": ["PREVIEW", "DEVELOPMENT", "STAGING"]
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "CONTRACT_CONFORMANCE",
          "AUTHORIZATION",
          "CORRELATION_ID",
          "SECRET_REDACTION",
          "RATE_LIMITING"
        ]
      }
    },
    "api_contract_ref": {"type": "string", "minLength": 1, "maxLength": 2048}
  },
  "allOf": [
    {
      "if": {
        "required": ["checks"],
        "properties": {
          "checks": {"contains": {"const": "CONTRACT_CONFORMANCE"}}
        }
      },
      "then": {"required": ["api_contract_ref"]}
    },
    {
      "if": {"required": ["api_contract_ref"]},
      "then": {
        "properties": {
          "checks": {"contains": {"const": "CONTRACT_CONFORMANCE"}}
        }
      }
    }
  ]
}
